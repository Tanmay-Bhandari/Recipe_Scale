rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public recipes: anyone can read recipes, only authenticated users may write.
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Ingredients: read publicly, writes require authentication.
    match /ingredients/{ingredientId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Daily Menus: Everyone can see what's for lunch/dinner.
    // Writes are currently open for development; restrict to request.auth != null if using login.
    match /daily-menus/{dayId} {
      allow read: if true;
      allow write: if true; 
    }

    // User profiles: only the user may read or write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny for all other resources.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
