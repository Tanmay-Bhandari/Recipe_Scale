rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public recipes: anyone can read recipes, only the author may write.
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Ingredients: read publicly, writes require authentication.
    match /ingredients/{ingredientId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profiles: only the user may read or write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Daily menus: allow client-side creation (unauthenticated clients save their menu),
    // allow authenticated reads, disallow updates/deletes from clients.
    match /daily_menus/{menuId} {
      // Require authenticated users to create/read daily menus.
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
